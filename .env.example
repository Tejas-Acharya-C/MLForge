# MLForge Local Environment Configuration Template
# Copy this file to .env for local development

# ==========================================
# Service & Server Configuration
# ==========================================
MLFORGE_ENV=development
MLFORGE_DEBUG=true
MLFORGE_HOST=127.0.0.1
MLFORGE_PORT=8000
MLFORGE_LOG_LEVEL=INFO

# ==========================================
# Filesystem & Artifact Storage (Local Only)
# ==========================================
# Dedicated local directory for evaluation artifacts, fold dumps, and HTML reports
MLFORGE_ARTIFACTS_DIR=./artifacts
MLFORGE_DATA_DIR=./data

# ==========================================
# Database Configuration (Planned for Phase 4)
# ==========================================
# NOTE: MLForge uses a dedicated database strictly separated from DataFlow
# Do not point this to DataFlow's database (e.g. dataflow_db).
# Direct SQLite fallback can be used locally during development:
MLFORGE_DATABASE_URL=sqlite:///./mlforge_local.db

# Planned PostgreSQL configuration for multi-run historical persistence:
# MLFORGE_DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/mlforge_db

# ==========================================
# Execution Engine Safeguards
# ==========================================
# Maximum cross-validation folds allowed in local interactive runs
MLFORGE_MAX_CV_FOLDS=10
# Default random seed for reproducibility
MLFORGE_DEFAULT_RANDOM_STATE=42
# Execution timeout in seconds per evaluation run
MLFORGE_RUN_TIMEOUT_SECONDS=300
